# Kconfig fragment applied on top of the virtme-ng default configuration
# when building the CI kernels.

# NOTE(invariant): `CONFIG_MMU_NOTIFIER` carries the interval-notifier
# machinery the peephole lifetime rides on. The symbol is promptless, so it
# is pulled in through a selector: host-side KVM.
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# Out-of-tree module loading for mirilla.ko.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Automatic /dev/mirilla node materialization in the guest.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
